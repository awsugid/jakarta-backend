# jakarta-backend environment example
# Copy this file to .env for local notes only. Cloudflare Worker vars/secrets
# are configured through wrangler.toml and `wrangler secret put`.

# Public Formbricks instance base URL.
# Worker var: FORMBRICKS_BASE_URL
FORMBRICKS_BASE_URL=https://forms.awscommunity.id

# Formbricks Management API key.
# Worker secret: FORMBRICKS_API_KEY
# Set with: wrangler secret put FORMBRICKS_API_KEY
FORMBRICKS_API_KEY=replace_with_formbricks_management_api_key

# Allowed frontend origins for CORS.
# Current code supports a single literal value. Use * for local/dev, or one origin for production.
# Worker var: ALLOWED_ORIGINS
ALLOWED_ORIGINS=*

# Google OAuth client ID used by the website Google Identity Services flow.
# Must match PUBLIC_GOOGLE_CLIENT_ID in jakarta-website.
# Worker var: GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com

# Enable local-only debug auth via X-Debug-User-Email.
# Keep false in production.
# Worker var: ENABLE_DEBUG_AUTH
ENABLE_DEBUG_AUTH=false

# D1 binding is configured in wrangler.toml, not .env:
# [[d1_databases]]
# binding = "DB"
# database_name = "jakarta-backend"
# database_id = "replace_with_d1_database_id"

# Add to your .env:
PRETIX_API_BASE_URL=https://pretix.eu          # your Pretix instance URL
PRETIX_API_TOKEN=<your-pretix-readonly-token>   # Pretix API token (read-only sufficient)

# Comma-separated keywords; any company whose name contains one of these
# (case-insensitive) is excluded from Top Companies. "personal" is always
# excluded. Leave unset to use built-in defaults.
COMPANY_EXCLUSION_KEYWORDS=
